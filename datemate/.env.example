# 공유용 빈 양식입니다. 실제 키는 이 파일이 아니라 복사본인 .env 에만 적으세요.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODE=demo

# 공공데이터포털 "한국관광공사_국문 관광정보 서비스_GW" 일반 인증키(Decoding). 축제 조회용, 무료.
TOUR_API_KEY=

# 네이버 클라우드 플랫폼 Maps: 주소 검색·역지오코딩·자동차 길찾기 (서버용)
NAVER_MAPS_KEY_ID=
NAVER_MAPS_KEY=
# 브라우저 지도(Dynamic Map)용 공개 ID. 콘솔에 접속 주소(예: http://127.0.0.1:8000)를 등록해야 합니다.
NAVER_MAPS_JS_KEY_ID=
# NAVER API HUB의 NAVER 검색(지역·이미지·블로그) 인증 키 (Maps 키와 별도)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 지도 선택용 공개 타일 (네이버 JS 키가 없을 때). 공개 서버 대량 다운로드 금지.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# 키가 아니라 공개 자료 요청 시 밝히는 연락처(이메일 등). 비워 두면 요청 간격이 길어집니다.
WIKI_CONTACT=
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=4

# Local: leave DATABASE_URL empty to use runtime/datemate.sqlite.
# Cloudflare Containers: set a PostgreSQL URL with sslmode=require (or stronger) as a Worker Secret.
DATABASE_URL=
DATEMATE_ENV=development
# Optional canonical HTTPS address; custom domains also set allowed hosts.
DATEMATE_PUBLIC_ORIGIN=
DATEMATE_ALLOWED_HOSTS=
DATEMATE_DB_POOL_SIZE=12
DATEMATE_IP_REQUESTS_PER_MINUTE=240
DATEMATE_USER_CHATS_PER_MINUTE=6

# Local operation (Compose sets these paths inside its persistent volume).
# DATEMATE_BACKUP_DIR=backups
DATEMATE_BACKUP_INTERVAL_SECONDS=3600
# Days without any use after which a browser's saved plans, chats and votes are deleted (public reviews stay, detached).
DATEMATE_RETENTION_DAYS=90
DATEMATE_RECOMMENDATIONS_PER_MINUTE=30
DATEMATE_USER_RECOMMENDATIONS_PER_MINUTE=6
DATEMATE_PROVIDER_CALLS_PER_HOUR=600
# One client IP range (IPv4 address or IPv6 /64) may use at most this many calls per provider per hour (default: half of the line above).
DATEMATE_PROVIDER_CALLS_PER_IP_PER_HOUR=300
# Per IP range, per minute. These hold even when the browser discards its session cookie.
# New browser sessions issued (sessions are created on the first /api/ call only).
DATEMATE_IP_SESSIONS_PER_MINUTE=30
# Requests to routes that call paid/quota providers (recommendations, address search, explore, festivals, photos, blogs, menus, chat). One explore screen asks for 24 photos.
DATEMATE_IP_EXPENSIVE_REQUESTS_PER_MINUTE=120
# Recommendations started (added to the per-browser limit above).
DATEMATE_IP_RECOMMENDATIONS_PER_MINUTE=12
# Place/plan chat questions (added to DATEMATE_USER_CHATS_PER_MINUTE).
DATEMATE_IP_CHATS_PER_MINUTE=12
# Address searches and map-point region lookups.
DATEMATE_IP_GEOCODE_PER_MINUTE=20
DATEMATE_IP_REVERSE_GEOCODE_PER_MINUTE=30
# Nearby restaurant searches.
DATEMATE_IP_LOCAL_SEARCHES_PER_MINUTE=30
# Forced re-reads (photo/menu refresh=true, price re-check).
DATEMATE_IP_REFRESHES_PER_MINUTE=12
# Review writes.
DATEMATE_IP_REVIEWS_PER_MINUTE=20
# Explore searches that are not already cached (each costs up to 16 provider calls).
DATEMATE_IP_EXPLORE_SEARCHES_PER_MINUTE=10
# Optional: actual contracted single-model token prices, USD per million.
# Leave blank when unknown. Estimates are not provider invoices.
DATEMATE_INPUT_USD_PER_MILLION=
DATEMATE_OUTPUT_USD_PER_MILLION=
# Local file produced by scripts/import_operating_data.py (never a remote URL).
DATEMATE_OPERATING_EVIDENCE_FILE=
# Total observed external HTTP/logical SDK attempts per recommendation.
DATEMATE_EXTERNAL_CALLS_PER_RECOMMENDATION=60
# Optional actual contracted HTTP prices, USD per 1,000 calls, keyed by hostname.
DATEMATE_HTTP_USD_PER_1000={}
# 코스 3안 고르는 방식. place=장소만 다르게(이전 방식), shadow=이전 방식으로 보여 주고 새 방식 결과는 진단·로그로만 남김(기본),
# experience=활동 구성이나 이동량이 실제로 다른 안을 골라 보여 줌. 되돌리려면 place 또는 shadow 로 바꾸고 재시작.
DATEMATE_OPTION_SELECTOR=shadow
# Cloudflare production requires DATABASE_URL; do not enable this in production.
# DATEMATE_EPHEMERAL_DEMO=1

# 사진 내용 검사. LLM 키(GMS_KEY)가 있을 때만 동작합니다. 켜져 있으면 검사를 통과한 사진(또는 업체 등록 사진)만 표시합니다.
# 꺼져 있거나 GMS_KEY가 없으면 검사 없이, 장소 일치가 확인된 사진을 "내용 미검사"로 표시합니다.
PHOTO_VISUAL_CHECK=true
