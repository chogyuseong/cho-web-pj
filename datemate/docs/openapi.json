  "components": {
    "schemas": {
      "ChatInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question"
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "real"
            ],
            "title": "Mode",
            "default": "demo"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatInput"
      },
      "Conditions": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "real"
            ],
            "title": "Mode",
            "default": "demo"
          },
          "region": {
            "type": "string",
            "title": "Region",
            "default": "서울"
          },
          "origin": {
            "$ref": "#/components/schemas/Point",
            "default": {
              "name": "데모 출발점",
              "lat": 37.575,
              "lon": 126.985
            }
          },
          "visit_date": {
            "type": "string",
            "format": "date",
            "title": "Visit Date"
          },
          "start": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "Start",
            "default": "11:00"
          },
          "end": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "title": "End",
            "default": "19:00"
          },
          "people": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "People",
            "default": 2
          },
          "budget": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Budget",
            "default": 100000
          },
          "transport": {
            "type": "string",
            "enum": [
              "walk",
              "transit",
              "car",
              "bicycle"
            ],
            "title": "Transport",
            "default": "walk"
          },
          "count": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 2.0,
            "title": "Count",
            "default": 3
          },
          "themes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 7,
            "title": "Themes"
          },
          "theme_mode": {
            "type": "string",
            "enum": [
              "mix",
              "focus"
            ],
            "title": "Theme Mode",
            "default": "mix"
          },
          "setting": {
            "type": "string",
            "enum": [
              "any",
              "indoor",
              "outdoor"
            ],
            "title": "Setting",
            "default": "any"
          },
          "avoid": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Avoid"
          },
          "reservation": {
            "type": "boolean",
            "title": "Reservation",
            "default": false
          },
          "max_leg": {
            "type": "integer",
            "maximum": 180.0,
            "minimum": 1.0,
            "title": "Max Leg",
            "default": 30
          },
          "max_walk": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 600.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Walk"
          },
          "return_home": {
            "type": "boolean",
            "title": "Return Home",
            "default": false
          },
          "home": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "type": "null"
              }
            ]
          },
          "mbti": {
            "type": "string",
            "pattern": "^([IE][NS][FT][JP])?$",
            "title": "Mbti",
            "default": ""
          },
          "use_mbti": {
            "type": "boolean",
            "title": "Use Mbti",
            "default": false
          },
          "request": {
            "type": "string",
            "maxLength": 4000,
            "title": "Request",
            "default": ""
          },
          "locked": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Locked"
          }
        },
        "type": "object",
        "required": [
          "visit_date"
        ],
        "title": "Conditions"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ParseInput": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ParseInput"
      },
      "Point": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          }
        },
        "type": "object",
        "required": [
          "name",
          "lat",
          "lon"
        ],
        "title": "Point"
      },
      "ReplaceInput": {
        "properties": {
          "index": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Index"
          },
          "locked": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Locked"
          },
          "replacement_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replacement Id"
          }
        },
        "type": "object",
        "required": [
          "index"
        ],
        "title": "ReplaceInput"
      },
      "ReportInput": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "ReportInput"
      },
      "ReviewInput": {
        "properties": {
          "rating": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating"
          },
          "body": {
            "type": "string",
            "maxLength": 500000,
            "minLength": 1,
            "title": "Body"
          },
          "nickname": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Nickname"
          },
          "visited": {
            "type": "string",
            "format": "date",
            "title": "Visited"
          }
        },
        "type": "object",
        "required": [
          "rating",
          "body",
          "nickname",
          "visited"
        ],
        "title": "ReviewInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}