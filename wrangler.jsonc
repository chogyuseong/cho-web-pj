{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datemate",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-12",
  "containers": [
    {
      "class_name": "DatemateContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DATEMATE_CONTAINER",
        "class_name": "DatemateContainer"
      }
    ]
  },
  "exports": {
    "DatemateContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
