{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datemate",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-12",
  // Builds cloudflare/generated/edge-pages.mjs (the "/" and "/shared" HTML with ?v= hashes)
  // from datemate/static. Wrangler runs it on every `wrangler deploy` and `wrangler dev`.
  "build": {
    "command": "node cloudflare/build-edge-pages.mjs",
    "watch_dir": "datemate/static"
  },
  // datemate/static is uploaded with the Worker so the first screen can be answered while
  // the container is asleep (cloudflare/edge.mjs). run_worker_first keeps every request going
  // through the Worker's host, probe and rate-limit checks; the Worker serves a file only
  // when the container is not running or still starting, and adds the app's headers.
  // html_handling "none": serve each file at its own path (no index.html redirects).
  "assets": {
    "directory": "./datemate/static",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "containers": [
    {
      "class_name": "DatemateContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DATEMATE_CONTAINER",
        "class_name": "DatemateContainer"
      }
    ]
  },
  "exports": {
    "DatemateContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  // Per-IP front shield checked by the Worker before the container wakes up.
  // Pages/API: 600 per 60 s, 2.5x the app's own 240/min, so the app limit trips first
  // for normal traffic. Static files (not limited by the app): 1200 per 60 s, about
  // 30 cold home-page loads per minute from one shared public IP.
  // namespace_id is an account-unique positive integer chosen for this Worker.
  "ratelimits": [
    {
      "name": "EDGE_LIMIT_APP",
      "namespace_id": "4101",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "EDGE_LIMIT_STATIC",
      "namespace_id": "4102",
      "simple": { "limit": 1200, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
